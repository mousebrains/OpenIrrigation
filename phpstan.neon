parameters:
  level: 8
  paths:
    - public_html
  excludePaths:
    - public_html/packages
    - public_html/js
    - public_html/css
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    # OI_DBNAME is defined in config.php, which make generates from
    # config.php.in; only DB::dbName() reads it
    -
      identifier: constant.notFound
      message: '#^Constant OI_DBNAME not found\.$#'
      path: public_html/php/DB1.php
