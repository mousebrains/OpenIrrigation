# This file is part of OpenIrrigation
#
# this service runs the script which builds daily reports and mails them out
#
# man systemd.unit for parameters
# man systemd.service for parameters
# man systemd.exec for parameters

[Unit]
Description=OpenIrrigation Daily Report Generator
# Email the 'systemd' subscribers (root if none) when this unit fails
OnFailure=OIFailure@%n.service
Requires=postgresql.service
After=postgresql.service
Requires=postfix.service
After=postfix.service
After=network.target

[Service]
# Resource containment and hardening (1GB Pi: a leak must not take down the host)
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
Type=oneshot
# A oneshot has no start timeout by default; a hung run must not hold the
# unit forever. A run is two attempts 60 s apart, each SMTP send 30 s at most.
TimeoutStartSec=10min
User=__USER__
Group=__GROUP__
WorkingDirectory=__LOGDIR__
ExecStart=__BINDIR__/dailyReport.py --db=__DBNAME__ --log=__LOGDIR__/DailyReport.log
