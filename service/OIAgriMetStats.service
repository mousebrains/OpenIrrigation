# This file is part of OpenIrrigation
#
# this service runs the script which builds AgriMet annual statistics
#
# man systemd.unit for parameters
# man systemd.service for parameters
# man systemd.exec for parameters

[Unit]
Description=OpenIrrigation Agrimet Stats Generator
# Email the 'systemd' subscribers (root if none) when this unit fails
OnFailure=OIFailure@%n.service
Requires=postgresql.service
After=postgresql.service
After=network.target

[Service]
# Resource containment and hardening (1GB Pi: a leak must not take down the host)
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
Type=oneshot
# A oneshot has no start timeout by default; a hung run must not hold the
# unit forever. Generous: it rebuilds the statistics over every ET row.
TimeoutStartSec=30min
User=__USER__
Group=__GROUP__
WorkingDirectory=__LOGDIR__
ExecStart=__BINDIR__/AgriMet.py --db=__DBNAME__ --stats --log=__LOGDIR__/AgriMetStats.log
